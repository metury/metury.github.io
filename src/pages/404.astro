---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Whoops..">
  <main class="common">
    <h1 class="header">
      404.
    </h1>
    
    <div class="standard">
    <h2 class="subheader">
      Page Not Found
    </h2>
    
    <p>
      Sorry, we couldn't find the page you're looking for. It might have been moved, or the link might be broken.
    </p>

    <div class="links">
    <a href="/" class="btn-link">
      Return Home
    </a>
    </div>
      
    </div>
  </main>
</BaseLayout>
