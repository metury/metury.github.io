---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Me">
  <main class="mt-16 sm:mt-24 pb-12">
    <h1 class="header">
      404.
    </h1>
    
    <div class="space-y-6 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
    <h2 class="text-2xl font-semibold text-gray-700 dark:text-gray-300 mb-6">
      Page Not Found
    </h2>
    
    <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-md">
      Sorry, we couldn't find the page you're looking for. It might have been moved, or the link might be broken.
    </p>

    <a href="/" class="btn-link">
      Return Home
    </a>
      
    </div>
  </main>
</BaseLayout>
