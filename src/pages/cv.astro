---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Me">
  <main class="mt-16 sm:mt-24 pb-12">
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-8">
      About Me
    </h1>
    
    <div class="space-y-6 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
      <p>
        Hi! I am a developer learning how to build fast, simple, and responsive websites. I recently started exploring Astro and Tailwind CSS.
      </p>
      
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-10 mb-4">
        My Skills
      </h2>
      
      <ul class="list-disc list-inside space-y-2 ml-4">
        <li>HTML, CSS, JavaScript</li>
        <li>Astro Framework</li>
        <li>Tailwind CSS</li>
        <li>Git & GitHub</li>
      </ul>
    </div>
  </main>
</BaseLayout>
