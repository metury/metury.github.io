---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="My Personal Website">
  <main class="mt-16 sm:mt-24 pb-12">
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">
      Hello, I'm a developer.
    </h1>
    <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 leading-relaxed">
      Welcome to my digital space. This is a simple, responsive personal website built with Astro and Tailwind CSS.
    </p>
    <a href="/about" class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-6 rounded-lg transition-colors">
      More about me
    </a>
  </main>
</BaseLayout>
