---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Bears Game">
  <main class="common">
  <div class="standard">
    <h1 class="header">Bears Game.</h1>
    <p>How many bears are by the lake? Can you figure out the secret rule?</p>

    <!-- 2x2 Dice Grid -->
    <div id="dice-grid" class="grid grid-cols-2 gap-4 w-fit mx-auto mb-8 text-8xl leading-none text-blue-500 dark:text-blue-500">
      <!-- Dice will be injected here by JavaScript -->
    </div>

    <!-- Game Controls -->
    <div>
      <div class="flex items-center justify-center gap-3">
        <input 
          type="number" 
          id="guess-input" 
          min="0" 
          class="w-24 px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="0"
        />
        <button 
          id="guess-btn" 
          class="px-6 py-2 bg-blue-600 hover:bg-blue-400 text-white font-medium rounded-lg transition-colors">
          Guess
        </button>
      </div>

      <p id="feedback" class="h-6 font-medium mt-4"></p>
    </div>
  </div>
  </main>
</BaseLayout>

<script>
  // Game Logic
  const diceFaces = ['⚀', '⚁', '⚂', '⚃', '⚄', '⚅'];
  const bearCounts = { 1: 0, 2: 0, 3: 2, 4: 0, 5: 4, 6: 0 };
  
  let currentSolution = 0;

  const diceGrid = document.getElementById('dice-grid');
  const guessInput = document.getElementById('guess-input');
  const guessBtn = document.getElementById('guess-btn');
  const feedback = document.getElementById('feedback');

  function rollDice() {
    // 1. Lock the inputs so the user can't guess while the dice are rolling
    guessInput.disabled = true;
    guessBtn.disabled = true;
    diceGrid.innerHTML = '';
    currentSolution = 0;
    
    const diceElements = [];
    const finalRolls = [];
    
    // 2. Pre-calculate the final solution and create the HTML elements
    for (let i = 0; i < 4; i++) {
      const roll = Math.floor(Math.random() * 6) + 1;
      finalRolls.push(roll);
      currentSolution += bearCounts[roll];
      
      const dieElement = document.createElement('div');
      // Adding Tailwind transition classes for smooth scaling and fading
      dieElement.className = "cursor-default select-none transition-all duration-75"; 
      diceGrid.appendChild(dieElement);
      diceElements.push(dieElement);
    }

    // 3. The Scramble Animation
    let rollCount = 0;
    const maxRolls = 10; // How many times the faces will flash
    
    const rollInterval = setInterval(() => {
      // Show random faces and make them look "unsettled" (slightly transparent and smaller)
      diceElements.forEach(die => {
        const randomFace = Math.floor(Math.random() * 6);
        die.textContent = diceFaces[randomFace];
        die.classList.add('opacity-50', 'scale-90');
      });
      
      rollCount++;

      // 4. Lock in the final rolls
      if (rollCount >= maxRolls) {
        clearInterval(rollInterval);
        
        diceElements.forEach((die, index) => {
          die.textContent = diceFaces[finalRolls[index] - 1];
          // Remove the unsettled look and add a quick "pop" effect
          die.classList.remove('opacity-50', 'scale-90');
          die.classList.add('scale-110');
          
          // Return to normal size after a tiny delay
          setTimeout(() => die.classList.remove('scale-110'), 150);
        });
        
        // Unlock the game
        guessInput.disabled = false;
        guessBtn.disabled = false;
        guessInput.focus();
      }
    }, 50); // Flashes a new random die every 50 milliseconds
  }

  function handleGuess() {
    const guess = parseInt(guessInput.value);
    
    if (isNaN(guess)) {
      feedback.textContent = "Please enter a number!";
      feedback.className = "h-6 font-medium mt-4 text-orange-500";
      return;
    }

    if (guess === currentSolution) {
      feedback.textContent = `Correct! There were ${currentSolution} bears. Rolling again...`;
      feedback.className = "h-6 font-medium mt-4 text-green-600 dark:text-green-400 text-center";
    } else {
      feedback.textContent = "Not quite! Try again.";
      feedback.className = "h-6 font-medium mt-4 text-red-600 dark:text-red-400 text-center";
    }
    guessInput.value = '';
    setTimeout(() => {
      feedback.textContent = '';
      rollDice();
    }, 2000);
  }

  // Event Listeners
  guessBtn.addEventListener('click', handleGuess);
  guessInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') handleGuess();
  });

  // Start the first game
  rollDice();
</script>
